APP_NAME=LedgerFly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# The first account can always be created; after that only invited people can sign up unless this is true.
REGISTRATION_ENABLED=false
BILL_REMINDER_DAYS=3
BUDGET_WARNING_PERCENTAGE=80
EXCHANGE_RATES_ENABLED=true
# Optional: login for php artisan db:seed --class=DemoSeeder (a random one is printed when empty)
# The ntfy server suggested to users for phone alerts. Users can still enter their own.
NTFY_SERVER=https://ntfy.sh

DEMO_EMAIL=demo@ledgerfly.test
DEMO_PASSWORD=

EXCHANGE_RATES_URL=https://open.er-api.com/v6/latest/{base}
DEFAULT_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ledgerfly
DB_USERNAME=ledgerfly
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=


REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Generate with: php artisan webpush:vapid
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
